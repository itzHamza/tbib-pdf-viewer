{
  "name": "@tbib-pdf-viewer/core",
  "version": "0.2.0",
  "description": "Framework-agnostic engine for PDF viewing and annotations",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.5.136",
    "perfect-freehand": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "pdf",
    "pdf-viewer",
    "pdf-annotator",
    "annotation",
    "freehand",
    "highlight",
    "pdfjs",
    "pdf-lib",
    "drawing",
    "excalidraw"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
