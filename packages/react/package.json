{
  "name": "@tbib-pdf-viewer/react",
  "version": "0.1.1",
  "description": "React wrapper for TBiB PDF Viewer",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@tbib-pdf-viewer/core": "^0.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "react",
    "pdf",
    "pdf-viewer",
    "pdf-annotator",
    "react-pdf",
    "annotation",
    "drawing",
    "excalidraw"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
